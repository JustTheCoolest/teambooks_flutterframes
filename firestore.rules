rules_version = '2'

service cloud.firestore {
  match /databases/{database}/documents {
    function verifyFields(required, optional) {
      let allAllowedFields = required.concat(optional);
      return request.resource.data.keys().hasAll(required) &&
        request.resource.data.keys().hasOnly(allAllowedFields);
    }
    function isRole(role) {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get(['roles', role], false) == true;
    }
    function validDonorDetails(details) {
      return details is map &&
        verifyFields(
          ['phoneNumber', 'name', 'companyOrApartment', 'email', 'wasOfflineDonorDetails'],
          []
        ) &&
        details.phoneNumber is string &&
        details.name is string &&
        details.companyOrApartment is string &&
        details.email is string &&
        details.wasOfflineDonorDetails is bool;
    }
    function validBookEntry(book) {
      return book is map &&
        verifyFields(
          ['isbn', 'bookDetails', 'wasOfflineBookDetails'],
          []
        ) &&
        (book.isbn == null || book.isbn is string) &&
        book.bookDetails is map &&
        book.wasOfflineBookDetails is bool;
    }
    match /CatalogQueue/{donation_id} {
      allow create: if
        // Top-level required fields and no extra fields
        verifyFields(
          ['volunteerUid', 'isAnonymous', 'books', 'donationTimestamp', 'registrationTimestamp'],
          ['donorDetails']
        ) &&

        request.resource.data.volunteerUid == request.auth.uid &&

        request.resource.data.isAnonymous is bool &&

        request.resource.data.books is list &&
        request.resource.data.books.size() > 0 &&

        request.resource.data.donationTimestamp is timestamp &&

        request.resource.data.registrationTimestamp is timestamp &&
        
        isRole('volunteer') &&

        // Validate each book entry strictly
        request.resource.data.books.hasOnly([
          b => validBookEntry(b)
        ]) &&
        // Donor details validation with strict fields
        (
          request.resource.data.isAnonymous == true ||
          (
            'donorDetails' in request.resource.data &&
            validDonorDetails(request.resource.data.donorDetails)
          )
        );
    }
  }
}